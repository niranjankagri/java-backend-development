<?xml version="1.0" encoding="UTF-8"?>
<!-- Session 19: Microservices. Two small Spring Boot services: catalog-service (the producer of product
     data) and order-service (its consumer), which calls the catalog through a Feign client and spreads
     its calls over several catalog instances with Spring Cloud LoadBalancer. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.niranjankagri</groupId>
        <artifactId>java-backend-development</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>session-19-microservices</artifactId>
    <name>Session 19: Microservices</name>

    <properties>
        <!-- Spring Cloud: Feign client + load balancer. Its own version line ("release train"),
             like the Spring Boot BOM: one version here sets the versions of all Spring Cloud parts. -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Feign: write an interface with @GetMapping methods, Spring Cloud writes the HTTP client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- picks one instance of "catalog-service" per call (round robin) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- /actuator/health: every service says whether it is up; the load balancer asks it (topic 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Two services live in this one module (to keep the course simple), so there are two
                 runnable jars, told apart by a classifier:
                   target/session-19-microservices-1.0.0-SNAPSHOT-catalog.jar
                   target/session-19-microservices-1.0.0-SNAPSHOT-orders.jar
                 In a real project each service is its own project with its own single jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- switch off the parent's one-jar execution ("default"): it cannot choose between two main classes -->
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>catalog-jar</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>jbdl.session19.catalog.CatalogServiceApplication</mainClass>
                            <classifier>catalog</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>orders-jar</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>jbdl.session19.orders.OrderServiceApplication</mainClass>
                            <classifier>orders</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
