<?xml version="1.0" encoding="UTF-8"?>
<!-- Session 11: JPA entities and Spring Data repositories on an in-memory H2 database. Hibernate
     writes the SQL; the same code runs on PostgreSQL or MySQL with another driver and URL. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.niranjankagri</groupId>
        <artifactId>java-backend-development</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>session-11-jpa</artifactId>
    <name>Session 11: Hibernate, Spring Data JPA</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JPA (the standard) + Hibernate (the implementation) + Spring Data repositories + HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- The JDBC driver + the database itself, in memory. Scope "runtime": our code only uses the
             java.sql interfaces; the driver is found at run time from the URL (jdbc:h2:...) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- runnable jar: java -jar target/session-11-jpa-1.0.0-SNAPSHOT.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
