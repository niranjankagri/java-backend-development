<?xml version="1.0" encoding="UTF-8"?>
<!-- Parent of the course: one Maven module per session that has code. It holds the shared Java
     version, dependency versions, compiler and test settings. Build everything with ./mvnw verify -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.niranjankagri</groupId>
    <artifactId>java-backend-development</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Java Backend Development - Spring Boot, Microservices with AI</name>

    <!-- Sessions without code (only README files) are not modules -->
    <modules>
        <module>session-01-java-architecture-oop</module>
        <module>session-02-advanced-java</module>
        <module>session-03-functional-programming-collections</module>
        <module>session-04-java-advanced-features</module>
        <module>session-05-concurrency</module>
        <module>session-06-maven</module>
        <module>session-07-maven-plugins</module>
        <module>session-08-spring-mvc-rest</module>
        <module>session-09-spring-boot-advanced</module>
        <module>session-10-jdbc</module>
        <module>session-11-jpa</module>
        <!-- The Splitwise project: built in Sessions 12, 13 and 17 -->
        <module>splitwise-backend</module>
        <module>session-14-junit-mockito</module>
        <module>session-15-redis-caching</module>
        <module>session-16-spring-security</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>

        <!-- Spring Boot sessions (8+) import this version's BOM in their own pom.xml -->
        <spring-boot.version>4.1.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Builds the runnable Spring Boot jar; activated only by the Spring Boot modules -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!-- Keep parameter names in the class files: Spring binds @PathVariable/@RequestParam by them -->
                    <parameters>true</parameters>
                    <!-- Warnings fail the build, so deprecated calls (like Thread.getId) cannot creep back in -->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
